#
# Personal additions on top of devices/common/config and the device config.
#
# prepare-build.sh appends this file last (CONFIG_FRAGMENT in build.yml), so it
# wins on any symbol set twice, and fails the build if defconfig drops one of
# the symbols requested here.
#
# Only additions: nothing here turns off a setting from devices/common/config.
# kmod-nft-bridge is not listed - kmod-nss-wifi-drv depends on it.
#

## Services
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

## WireGuard userspace and LuCI (kmod-wireguard is in devices/common/config)
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## USB drives (usb-storage, UAS, block-mount and ext4 are in devices/common/config)
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

## CLI tools (curl, htop and iperf3 are in devices/common/config)
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_tar=y
# tar's xz support (on by default) hides tar unless xz-utils is selected
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_tcpdump=y

## Kernel debugging: perf profiling and runtime-switchable driver debug prints
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_DYNAMIC_DEBUG=y
